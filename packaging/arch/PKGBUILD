# Maintainer: PCL-L <pcl-l@example.com>
pkgname=pcl-l
pkgver=1.0.2
pkgrel=1
pkgdesc="PCL-L (Plain Craft Launcher for Linux)"
arch=('x86_64')
url="https://github.com/135hshsjsv/PCL-L"
license=('Apache-2.0')
depends=('glibc' 'icu' 'openssl' 'zlib' 'fontconfig' 'freetype2' 'libx11' 'libice' 'libsm' 'libxrandr' 'libxi' 'mesa' 'glib2')
options=('!strip' '!debug')
source=()
sha256sums=()

package() {
  install -d "$pkgdir/opt/pcl-l"
  cp -a "$PCL_PAYLOAD"/. "$pkgdir/opt/pcl-l/"
  chmod 755 "$pkgdir/opt/pcl-l/PCL.Frontend.Avalonia"
  install -Dm644 "$startdir/pcl-l.desktop" "$pkgdir/usr/share/applications/pcl-l.desktop"
  install -Dm644 "$startdir/pcl-l.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/pcl-l.png"
}
