# Maintainer: PlainCraftLauncher - Linux <pcl-l@example.com>
pkgname=plaincraftlauncher
pkgver=1.0.0
pkgrel=1
pkgdesc="PlainCraftLauncher - Linux (Plain Craft Launcher for Linux)"
arch=('x86_64')
url="https://github.com/"
license=('Apache-2.0')
depends=('glibc' 'icu' 'openssl' 'zlib' 'fontconfig' 'freetype2' 'libx11' 'libice' 'libsm' 'libxrandr' 'libxi' 'mesa' 'glib2')
options=('!strip' '!debug')
source=()
sha256sums=()

package() {
  install -d "$pkgdir/opt/plaincraftlauncher"
  cp -a "$PCL_PAYLOAD"/. "$pkgdir/opt/plaincraftlauncher/"
  chmod 755 "$pkgdir/opt/plaincraftlauncher/PCL.Frontend.Avalonia"
  install -Dm644 "$startdir/plaincraftlauncher.desktop" "$pkgdir/usr/share/applications/plaincraftlauncher.desktop"
  install -Dm644 "$startdir/plaincraftlauncher.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/plaincraftlauncher.png"
}
