<UserControl
    x:Class="PCL.Frontend.Avalonia.Desktop.Panes.Right.MultiplayerRightPaneView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:PCL.Frontend.Avalonia.ViewModels"
    x:DataType="vm:LauncherViewModel"
    xmlns:controls="clr-namespace:PCL.Frontend.Avalonia.Desktop.Controls"
    DataContext="{ReflectionBinding Launcher}">
  <UserControl.Styles>
    <Style Selector="controls|PclButton.mp-action">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="RenderTransform" Value="translateY(0px)" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
          <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
        </Transitions>
      </Setter>
      <Style.Animations>
        <Animation Duration="0:0:0.5" Easing="CubicEaseOut" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="controls|PclButton.mp-action:pointerover">
      <Setter Property="RenderTransform" Value="scale(1.05)" />
    </Style>
    <Style Selector="controls|PclButton.mp-action:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="controls|PclButton.mp-action:disabled:pointerover">
      <Setter Property="RenderTransform" Value="scale(1)" />
    </Style>
  </UserControl.Styles>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="25,10,25,25" Spacing="15">
      <controls:PclCard Header="{Binding MultiplayerTitleText}" ContentMargin="25,40,25,20">
        <controls:PclCard.CardContent>
          <StackPanel Spacing="12">
            <TextBlock
                FontSize="14"
                Foreground="{DynamicResource ColorBrushMsgBoxText}"
                Text="{Binding MultiplayerStatusText}"
                TextWrapping="Wrap" />
            <TextBlock
                FontSize="12.5"
                Foreground="{DynamicResource ColorBrush2}"
                IsVisible="{Binding ShowMultiplayerStatusDetail}"
                Text="{Binding MultiplayerStatusDetail}"
                TextWrapping="Wrap" />
            <ProgressBar
                Height="6"
                IsVisible="{Binding IsMultiplayerBusy}"
                Maximum="1"
                Minimum="0"
                Value="{Binding MultiplayerProgress}" />

            <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding ShowMultiplayerJoinInput}">
              <TextBlock
                  Margin="0,0,25,0"
                  VerticalAlignment="Center"
                  FontSize="13.5"
                  Foreground="{DynamicResource ColorBrush1}"
                  Text="{Binding MultiplayerJoinCodeLabelText}" />
              <TextBox
                  Grid.Column="1"
                  Height="28"
                  Padding="8,4"
                  Text="{Binding MultiplayerJoinCode, Mode=TwoWay}"
                  Watermark="{Binding MultiplayerJoinCodeWatermark}" />
            </Grid>

            <TextBlock
                FontSize="13"
                Foreground="{DynamicResource ColorBrushRedLight}"
                IsVisible="{Binding ShowMultiplayerError}"
                Text="{Binding MultiplayerErrorText}"
                TextWrapping="Wrap" />

            <StackPanel Margin="0,5,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
              <controls:PclButton
                  Height="35"
                  MinWidth="120"
                  Classes="mp-action"
                  ColorType="Highlight"
                  Command="{Binding StartMultiplayerHostingCommand}"
                  IsEnabled="{Binding CanStartMultiplayerHosting}"
                  Text="{Binding MultiplayerHostButtonText}" />
              <controls:PclButton
                  Height="35"
                  MinWidth="120"
                  Margin="15,0,0,0"
                  Classes="mp-action"
                  Command="{Binding JoinMultiplayerRoomCommand}"
                  IsEnabled="{Binding CanJoinMultiplayerRoom}"
                  Text="{Binding MultiplayerJoinButtonText}" />
              <controls:PclButton
                  Height="35"
                  MinWidth="120"
                  Margin="15,0,0,0"
                  Classes="mp-action"
                  Command="{Binding LeaveMultiplayerRoomCommand}"
                  IsEnabled="{Binding CanLeaveMultiplayerRoom}"
                  Text="{Binding MultiplayerLeaveButtonText}" />
            </StackPanel>
          </StackPanel>
        </controls:PclCard.CardContent>
      </controls:PclCard>

      <controls:PclCard Header="{Binding MultiplayerMembersLabelText}" ContentMargin="25,40,25,15" IsVisible="{Binding ShowMultiplayerMembers}">
        <controls:PclCard.CardContent>
          <ItemsControl ItemsSource="{Binding MultiplayerMembers}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,2" ColumnDefinitions="*,Auto">
                  <TextBlock
                      FontSize="13.5"
                      Foreground="{DynamicResource ColorBrushMsgBoxText}"
                      Text="{Binding Name}"
                      TextTrimming="CharacterEllipsis" />
                  <TextBlock
                      Grid.Column="1"
                      FontSize="12"
                      Foreground="{DynamicResource ColorBrush2}"
                      Text="{Binding KindLabel}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </controls:PclCard.CardContent>
      </controls:PclCard>

      <controls:PclCard Header="{Binding MultiplayerRoomCodeLabelText}" ContentMargin="25,40,25,15" IsVisible="{Binding ShowMultiplayerRoomCode}">
        <controls:PclCard.CardContent>
          <StackPanel Spacing="10">
            <TextBlock
                FontSize="17"
                FontWeight="Bold"
                Foreground="{DynamicResource ColorBrush1}"
                Text="{Binding MultiplayerRoomCode}" />
            <StackPanel IsVisible="{Binding ShowMultiplayerDirectAddress}" Spacing="2">
              <TextBlock
                  FontSize="12"
                  Foreground="{DynamicResource ColorBrush2}"
                  Text="{Binding MultiplayerDirectAddressLabelText}" />
              <TextBlock
                  FontSize="14"
                  Foreground="{DynamicResource ColorBrushTitleBarForeground}"
                  Text="{Binding MultiplayerDirectAddress}" />
            </StackPanel>
          </StackPanel>
        </controls:PclCard.CardContent>
      </controls:PclCard>

      <TextBlock
          Margin="5,0,5,0"
          FontSize="11.5"
          Foreground="{DynamicResource ColorBrush2}"
          Text="{Binding MultiplayerCopyrightText}"
          TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
